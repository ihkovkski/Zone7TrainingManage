rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // แบบง่าย: การล็อกอินตรวจสอบในหน้าเว็บ ฐานข้อมูลเปิดให้อ่าน/เขียนได้
    // ใช้ได้เฉพาะ 3 collection ของระบบนี้เท่านั้น
    match /users/{id}     { allow read, write: if true; }
    match /speakers/{id}  { allow read, write: if true; }
    match /trainings/{id} { allow read, write: if true; }
    match /expertise/{id} { allow read, write: if true; }
  }
}
